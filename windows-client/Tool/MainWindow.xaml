<Window x:Class="Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Tool.Models"
        xmlns:converters="clr-namespace:Tool.Converters"
        mc:Ignorable="d"
        Title="SNA Pro — Streaming Drama Manager &amp; Batch Downloader"
        Height="820" Width="1360"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />

        <!-- Custom ScrollBar Theme -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
        </Style>

        <!-- Custom Card Button Style -->
        <Style x:Key="DramaCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#06B6D4" />
                                <Setter TargetName="border" Property="Background" Value="#24334A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header & Search Bar -->
            <RowDefinition Height="74" />
            <!-- Main Content Area: Left Library + Right Detail -->
            <RowDefinition Height="*" />
            <!-- Bottom Footer Actions & Progress -->
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. TOP HEADER & PLATFORM SWITCHER BAR -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand Logo -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Platform Switcher Tabs -->
                    <ColumnDefinition Width="Auto" />
                    <!-- URL Search Input -->
                    <ColumnDefinition Width="*" />
                    <!-- License Status -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#06B6D4" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SNA Pro" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Drama Downloader Suite" FontSize="11" Foreground="#06B6D4" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Platform Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="#0F172A" CornerRadius="10" Padding="4" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="HongGuo" Command="{Binding SwitchPlatformCommand}" CommandParameter="{x:Static models:PlatformType.HongGuo}"
                                         IsChecked="True" GroupName="PlatformGroup" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="14,6" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" />
                            <RadioButton Content="WeTV (Tencent)" Command="{Binding SwitchPlatformCommand}" CommandParameter="{x:Static models:PlatformType.WeTV}"
                                         GroupName="PlatformGroup" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="14,6" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" />
                            <RadioButton Content="iQIYI" Command="{Binding SwitchPlatformCommand}" CommandParameter="{x:Static models:PlatformType.iQIYI}"
                                         GroupName="PlatformGroup" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="14,6" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Search Input Bar -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchUrl, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" Padding="14,10" FontSize="13"
                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1"
                             VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10,0,0,10" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1" Command="{Binding FetchEpisodesCommand}"
                            Content="Fetch Series" Height="42" Padding="20,0"
                            Background="#06B6D4" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,10,10,0" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- License Status Pill -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="12,5">
                        <TextBlock Text="{Binding LicenseStatusText}" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. MAIN TWO-COLUMN WORKSPACE -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: Series Library (340px) -->
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="440" />
                <ColumnDefinition Width="1" />
                <!-- Right Panel: Episode Grid & Detail -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- LEFT PANEL: DRAMA LIBRARY -->
            <!-- ============================================================= -->
            <Border Grid.Column="0" Background="#0F172A" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,12">
                        <TextBlock Text="SERIES LIBRARY" FontSize="11" FontWeight="Bold" Foreground="#64748B" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding DramaLibrary.Count, StringFormat='{}{0} Titles'}" FontSize="11" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Scrollable Drama Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DramaLibrary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DramaCardStyle}" Margin="0,0,0,10"
                                            Command="{Binding DataContext.SelectDramaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Poster Thumbnail -->
                                            <Border Grid.Column="0" Width="64" Height="86" CornerRadius="8" Background="#334155" ClipToBounds="True">
                                                <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Title & Metadata -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap" />
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Resolution}" FontSize="9" FontWeight="Bold" Foreground="#93C5FD" />
                                                    </Border>
                                                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding TotalEpisodes, StringFormat='{}{0} EPs'}" FontSize="9" FontWeight="Bold" Foreground="#6EE7B7" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Column Splitter Divider -->
            <Rectangle Grid.Column="1" Fill="#334155" />

            <!-- ============================================================= -->
            <!-- RIGHT PANEL: SELECTED SHOW & EPISODE WRAPPANEL -->
            <!-- ============================================================= -->
            <Grid Grid.Column="2" Background="#0B1120" Margin="0">
                <Grid.RowDefinitions>
                    <!-- Show Header & Save Picker -->
                    <RowDefinition Height="Auto" />
                    <!-- Episode Cards WrapPanel -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Show Header Banner -->
                <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="24,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Cover Thumbnail -->
                        <Border Grid.Column="0" Width="80" Height="100" CornerRadius="10" Background="#334155" ClipToBounds="True" Margin="0,0,20,0">
                            <Image Source="{Binding SelectedDrama.CoverUrl}" Stretch="UniformToFill" />
                        </Border>

                        <!-- Title, Album ID, Summary -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedDrama.Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Border Background="#1E3A8A" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedDrama.Resolution}" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedDrama.Summary}" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="600" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Album ID: " FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding SelectedDrama.Id}" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" FontFamily="Consolas" Margin="0,0,16,0" />

                                <TextBlock Text="Total Available: " FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding CurrentEpisodes.Count, StringFormat='{}{0} Episodes'}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Save Directory Picker -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="280">
                            <TextBlock Text="DOWNLOAD DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SaveDirectory}" IsReadOnly="True"
                                         Height="36" Padding="8,8" FontSize="11" FontFamily="Consolas"
                                         Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding BrowseSaveDirectoryCommand}"
                                        Content="Browse" Height="36" Padding="12,0"
                                        Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Episode Cards Grid (WrapPanel) -->
                <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CurrentEpisodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="190" Height="175" Background="#1E293B" CornerRadius="12" Margin="0,0,14,14"
                                        BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" BorderThickness="1.5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Video Thumbnail Area -->
                                            <RowDefinition Height="100" />
                                            <!-- Info & Progress Area -->
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Video Thumbnail with Duration Overlay -->
                                        <Border Grid.Row="0" CornerRadius="11,11,0,0" ClipToBounds="True" Background="#0F172A">
                                            <Grid>
                                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                                
                                                <!-- Duration Overlay Badge -->
                                                <Border Background="#CC0F172A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding Duration}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>

                                                <!-- Checkbox Selection Overlay -->
                                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                          Cursor="Hand">
                                                    <CheckBox.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                                    </CheckBox.LayoutTransform>
                                                </CheckBox>
                                            </Grid>
                                        </Border>

                                        <!-- Episode Title & Download Telemetry -->
                                        <Border Grid.Row="1" Padding="10,8">
                                            <StackPanel VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" DockPanel.Dock="Left" />
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                               HorizontalAlignment="Right" />
                                                </DockPanel>

                                                <!-- Mini Progress Bar -->
                                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,6,0,4"
                                                             Background="#0F172A" Foreground="#10B981" BorderThickness="0" />

                                                <DockPanel>
                                                    <TextBlock Text="{Binding Speed}" FontSize="10" Foreground="#94A3B8" DockPanel.Dock="Left" />
                                                    <TextBlock Text="{Binding Progress, StringFormat='{}{0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 3. BOTTOM FOOTER CONTROLS & OVERALL PROGRESS -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Left: Select All / Deselect -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center: Concurrency & Overall Progress -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Start Download Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Select All / Deselect Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SelectAllCommand}" Content="Select All"
                            Padding="12,6" Background="#334155" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                        </Button.Resources>
                    </Button>
                    <Button Command="{Binding DeselectAllCommand}" Content="Deselect All"
                            Padding="12,6" Background="#334155" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,16,0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="{Binding TotalSelectedCount, StringFormat='{}{0} Selected'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Worker Count & Global Progress Bar -->
                <Grid Grid.Column="1" Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Threads:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding WorkerOptions}" SelectedItem="{Binding WorkerCount}"
                                  Width="60" Height="30" FontSize="11" FontWeight="Bold"
                                  Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" MaxWidth="350" />
                            <TextBlock Text="{Binding OverallProgress, StringFormat='Overall: {0:F1}%'}" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                        </DockPanel>
                        <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="8"
                                     Background="#0F172A" Foreground="#10B981" BorderThickness="0">
                            <ProgressBar.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                    </StackPanel>
                </Grid>

                <!-- Start Download / Cancel Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding StartDownloadCommand}" Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVisConverter}}"
                            Content="⚡ Start Download" Height="42" Padding="24,0"
                            Background="#10B981" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Command="{Binding CancelDownloadCommand}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisConverter}}"
                            Content="⏹ Cancel" Height="42" Padding="20,0"
                            Background="#E11D48" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
