<Window x:Class="Tool.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Update Center - Tool Dubber"
        Height="540" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B1120"
        FontFamily="Segoe UI"
        Foreground="#F8FAFC">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Auto Update Center" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                <TextBlock Text="Tool Dubber — Keep your video AI dubbing engine up to date" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="#0369A1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusBadge" Text="Update Center" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
            </Border>
        </Grid>

        <!-- Version & Info Card -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CURRENT VERSION" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock x:Name="TxtCurrentVersion" Text="1.2.0" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="LATEST VERSION" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock x:Name="TxtLatestVersion" Text="--" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="LAST CHECKED" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                    <TextBlock x:Name="TxtLastChecked" Text="Today" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Release Notes Section -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Release Notes" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6" />

            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtReleaseNotes" Text="Click 'Check for Updates' to search for newer releases."
                               FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Download & Verification Progress Card -->
        <Border Grid.Row="3" x:Name="PnlProgress" Background="#1E293B" CornerRadius="8" BorderBrush="#0284C7" BorderThickness="1" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtProgressStatus" Grid.Column="0" Text="Downloading update..." FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" />
                    <TextBlock x:Name="TxtDownloadStats" Grid.Column="1" Text="0 MB / 0 MB (0 MB/s)" FontSize="11" Foreground="#94A3B8" />
                </Grid>

                <ProgressBar x:Name="ProgressBarDownload" Height="8" Background="#0F172A" Foreground="#0284C7" BorderThickness="0" Minimum="0" Maximum="100" Value="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Check for updates -->
            <Button Grid.Column="0" x:Name="BtnCheckUpdates" Content="🔄 Check for Updates" Click="BtnCheckUpdates_Click"
                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" />

            <!-- Retry Download -->
            <Button Grid.Column="2" x:Name="BtnRetry" Content="Retry Download" Click="BtnRetry_Click"
                    Background="#B91C1C" Foreground="#FFFFFF" Margin="0,0,8,0" Visibility="Collapsed" />

            <!-- Later -->
            <Button Grid.Column="3" x:Name="BtnLater" Content="Later" Click="BtnLater_Click"
                    Background="#334155" Foreground="#F8FAFC" Margin="0,0,8,0" />

            <!-- Update Now -->
            <Button Grid.Column="4" x:Name="BtnUpdateNow" Content="Update Now" Click="BtnUpdateNow_Click"
                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
