<Window x:Class="Tool.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update Available"
        Height="400" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="New Version Available" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock x:Name="TxtVersionInfo" Text="Version 1.0.5 is now available for download." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Release notes -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtReleaseNotes" Text="Release Notes..." FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!-- Progress bar during download -->
        <StackPanel Grid.Row="2" x:Name="PnlProgress" Margin="0,0,0,16" Visibility="Collapsed">
            <TextBlock x:Name="TxtProgressStatus" Text="Downloading update (0%)..." FontSize="11" Foreground="#818CF8" Margin="0,0,0,4" />
            <ProgressBar x:Name="ProgressBarDownload" Height="6" Background="#1E293B" Foreground="#4F46E5" BorderThickness="0" Minimum="0" Maximum="100" />
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" x:Name="BtnLater" Content="Later" Click="BtnLater_Click"
                    Padding="16,8" Background="#334155" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2" x:Name="BtnUpdateNow" Content="Update Now" Click="BtnUpdateNow_Click"
                    Padding="20,8" Background="#4F46E5" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
